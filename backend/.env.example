# Copie para .env e ajuste. O .env nunca vai para o git.

# development: Vite + API separados; production: Express entrega o frontend compilado
NODE_ENV=development

# Portas do frontend e da API em desenvolvimento (precisam ser diferentes);
# em produção o Express usa só API_PORT
FRONTEND_PORT=5173
API_PORT=3333

# SQL Server local com autenticação do Windows via ODBC (driver msnodesqlv8).
# Não precisa habilitar TCP nem criar usuário com senha no SQL Server.
DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=Inkflow;Trusted_Connection=Yes;TrustServerCertificate=Yes;

# Banco na Azure (Azure SQL Database): usuário e senha do SQL. Passo a passo em
# database/README.md, seção "Banco na Azure". Banco novo: npm run db:setup.
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:SEU-SERVIDOR.database.windows.net,1433;Database=Inkflow;Uid=USUARIO;Pwd=SENHA;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Segredo que assina o cookie de sessão (mín. 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Quantos dias o login continua válido (mesmo fechando o navegador)
SESSION_DAYS=30

# Só para o script npm run db:dev-accounts (contas de teste em desenvolvimento)
# ADMIN_EMAIL=admin@inkflow.com
# ADMIN_PASSWORD=

# Explicação das questões por IA (opcional): botão "Gerar com IA" no admin do site e do
# app desktop. Chave gratuita do Google Gemini em https://aistudio.google.com/apikey
# (no plano gratuito o Google pode usar o texto enviado para melhorar os produtos;
# só o enunciado e as alternativas são enviados).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
