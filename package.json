{
  "name": "inkflow",
  "version": "0.1.0",
  "private": true,
  "description": "Inkflow — plataforma de preparação para o ENADE (monorepo: frontend, backend e banco)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n front,api -c magenta,cyan \"npm:dev:front\" \"npm:dev:api\"",
    "dev:front": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint -w frontend",
    "db:dev-accounts": "npm run db:dev-accounts -w backend"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
